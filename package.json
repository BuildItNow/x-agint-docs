{
  "name": "@x-agint/github-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Demo capture scripts and documentation for the x-agint MCP servers. Contains no server source.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "demo",
    "ai-agent",
    "ai-native",
    "agent-native"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "author": {
    "name": "Yang G",
    "url": "https://github.com/BuildItNow/x-agint-docs"
  },
  "license": "MIT",
  "scripts": {
    "gif:flight": "node scripts/make-gif.mjs --steps assets/flight-demo/steps.json --out assets/flight-demo/flight-booking.gif",
    "gif:migu": "node scripts/make-gif.mjs --steps assets/migu-demo/steps.json --out assets/migu-demo/migu-playlist.gif",
    "gif:github": "node scripts/make-gif.mjs --steps assets/github-demo/steps.json --out assets/github-demo/publish-to-github.gif"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "gifenc": "^1.0.3"
  }
}
